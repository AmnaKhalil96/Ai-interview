# Copy to .env.local and fill in with your Firebase project's web app config.
# .env.local is already gitignored by the Next.js default .gitignore.
#
# NEXT_PUBLIC_FIREBASE_PROJECT_ID is also read server-side, by
# src/lib/verifyIdToken.ts, as the expected issuer/audience when verifying
# a request's Firebase Auth ID token — it's already public (embedded in
# the client bundle) so reusing it server-side needs no separate secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google AI Studio API key, used server-side only (no NEXT_PUBLIC_ prefix —
# this must never reach the browser bundle). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. A second Gemini API key from a SEPARATE Google account/project
# (its own independent free-tier quota, not just a different key on the
# same project). The free tier caps at a low PER-DAY quota (as low as 20
# requests/day for some models) rather than a per-minute limit, so once
# GEMINI_API_KEY hits it, every request fails for the rest of the day —
# lib/ai/geminiClient.ts automatically retries once against this backup
# key, but ONLY when the primary key's failure is specifically a
# quota/rate-limit error (HTTP 429), never for other kinds of failures.
# Leave unset if you only have one key; the app works fine without it,
# it just won't have anywhere to fall back to.
GEMINI_API_KEY_BACKUP=
